    <munit:test name="plc-subscribe">
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="subscribe-eventhandler1a" />
            <munit:enable-flow-source value="subscribe-eventhandler1b" />
            <munit:enable-flow-source value="subscribe-eventhandler2" />
            <munit:enable-flow-source value="subscribe-eventhandler3" />
        </munit:enable-flow-sources>
        <munit:execution>
            <munit-tools:clear-stored-data doc:name="Clear stored data"
                doc:id="8fcb6e9b-0b31-45cb-b13c-45378b1802ca" />
            <plc:write doc:name="Write1" config-ref="PLC_Config_Subscribe1">
                <reconnect count="5" frequency="500" />
                <plc:write-fields>
                    <plc:write-field alias="coil1" address="STATE/coil1:BOOL[2]"
                        values="#[ [ true, false ] ]" />
                </plc:write-fields>
            </plc:write>
            <munit-tools:sleep time="100" doc:name="Sleep"
                doc:id="1ab5fcfc-7f49-4d9e-8aa4-52da52678d90" />
            <plc:subscribe doc:name="Subscribe" config-ref="PLC_Config_Subscribe1"
                eventHandler="Event_handler1"
            >
                <plc:subscribe-fields>
                    <plc:subscribe-field alias="coil1" address="STATE/coil1:BOOL[2]" />
                    <plc:subscribe-field alias="reg1" address="STATE/register1:INT[2]" />
                </plc:subscribe-fields>
            </plc:subscribe>
            <plc:write doc:name="Write1" config-ref="PLC_Config_Subscribe1">
                <reconnect count="5" frequency="500" />
                <plc:write-fields>
                    <plc:write-field alias="coil1" address="STATE/coil1:BOOL[2]"
                        values="#[[ false, true ]]" />
                </plc:write-fields>
            </plc:write>
            <munit-tools:sleep time="100" doc:name="Sleep"
                doc:id="f97f98b1-7236-48e5-818c-ab20cafcb228" />
            <plc:write doc:name="Write2" config-ref="PLC_Config_Subscribe1">
                <reconnect count="5" frequency="500" />
                <plc:write-fields>
                    <plc:write-field alias="reg1" address="STATE/register1:INT[2]"
                        values="#[[ '111', '222' ]]" />
                </plc:write-fields>
            </plc:write>
            <munit-tools:sleep time="100" doc:name="Sleep"
                doc:id="6145bb9d-295d-420c-9ea6-cab70ca30773" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[sizeOf( payload )]" expected="#[1]"
                message="#['expected payload size == 1, but was: ' ++ sizeOf(payload ) as String]"
                doc:name="payload size == 1" />
            <munit-tools:dequeue doc:name="subscribe-eventhandler1a-payload"
                doc:id="e73cca47-46b6-496b-8c13-3c06286c3a0f" queueName="subscribe-eventhandler1a-payload"
                timeout="#[100]" />
            <logger level="INFO" doc:name="Logger" doc:id="60db88db-13ef-409a-9dbc-f34d345243cc"
                message="#[payload]" />
            <munit-tools:assert-equals doc:name="alias == coil1"
                doc:id="27cf1fc6-6949-4eb8-96a1-fa023077dbb9" actual="#[payload[0].alias]" expected="coil1"
                message="wrong alias" />
            <munit-tools:assert-equals doc:name="result == ok"
                doc:id="5f964c34-c6fb-4c1e-98d9-2461ff5375fb" actual="#[payload[0].result]" expected="OK"
                message="wrong result" />
            <munit-tools:assert-equals doc:name="value is list"
                doc:id="04081e70-9fc5-4c57-881a-0fb7a9f8e0f1" actual="#[payload[0].value.list]" expected="#[true]"
                message="wrong value" />
            <munit-tools:assert-equals doc:name="value 0 as boolean"
                doc:id="d6fd01ef-55fb-40d7-b063-bcd205ca9e8d" actual="#[payload[0].value.asList[0].asBoolean]"
                expected="#[false]" message="wrong value" />
            <munit-tools:assert-equals doc:name="value 1 as boolean"
                doc:id="c56413ad-7766-4697-9235-59ded17bb74d" actual="#[payload[0].value.asList[1].asBoolean]"
                expected="#[true]" message="wrong value" />
            <munit-tools:dequeue doc:name="subscribe-eventhandler1a-payload"
                doc:id="43d0566b-0941-4758-a526-9e9977193137" queueName="subscribe-eventhandler1a-payload"
                timeout="#[100]" />
            <logger level="INFO" doc:name="Logger" doc:id="c4e8bfd9-6db0-4eeb-8777-43574586bdff"
                message="#[payload]" />
            <munit-tools:assert-equals doc:name="alias == reg1"
                doc:id="b2592370-3043-4ec9-84db-60d4518bd2ac" actual="#[payload[0].alias]" expected="reg1"
                message="wrong alias" />
            <munit-tools:assert-equals doc:name="result == ok"
                doc:id="a52bd90e-70bb-4c1e-8602-76f839ff45a9" actual="#[payload[0].result]" expected="OK"
                message="wrong result" />
            <munit-tools:assert-equals doc:name="value is list"
                doc:id="c63dfafe-ad6d-4825-bc75-3662b438dd3f" actual="#[payload[0].value.list]" expected="#[true]"
                message="wrong value" />
            <munit-tools:assert-equals doc:name="value 0 as integer"
                doc:id="40add353-ea56-4fa5-837e-2b5157bc071f" actual="#[payload[0].value.asList[0].asInteger]"
                expected="#[111]" message="wrong value" />
            <munit-tools:assert-equals doc:name="value 1 as integer"
                doc:id="b1292605-6f62-4bf6-9748-595f59ee0401" actual="#[payload[0].value.asList[1].asInteger]"
                expected="#[222]" message="wrong value" />
        </munit:validation>
    </munit:test>

